{
  "name": "vite-react",
  "framework": "vite",
  "packages": ["vite", "react", "@vitejs/plugin-react"],
  "dev": ["node_modules/.bin/vite", "--port", "{port}", "--strictPort", "--host", "127.0.0.1"],
  "readyPath": "/",
  "readyTimeoutMs": 60000,
  "hmr": {
    "tokenFrom": { "path": "/@vite/client", "regex": "wsToken\\s*=\\s*\"([^\"]+)\"" },
    "path": "/?token={token}",
    "protocol": "vite-hmr",
    "updatePattern": "\"type\":\"(update|full-reload)\""
  },
  "edit": { "file": "src/App.jsx", "from": "Hello devhop", "to": "Hello again" }
}
